#!/bin/sh /etc/rc.common
# procd service: plays the relay's live stream on the NanoPi R5C's HDMI port.
# Installed as /etc/init.d/pyxis-hdmi by setup.sh. Settings (also on the settings page):
#   uci set pyxis.hdmi.enabled=0|1        (default 1)
#   uci set pyxis.hdmi.match_rate=0|1     (default 1: use a refresh rate that's a multiple of the stream's frame rate when the screen has one)
#   uci set pyxis.hdmi.low_latency=0|1    (default 0: smooth motion; 1: each frame at the next refresh, no smoothing buffer)
# shellcheck disable=SC2034  # START/STOP/USE_PROCD are read by /etc/rc.common

START=96
STOP=09
USE_PROCD=1

PROG=/usr/bin/pyxis-hdmi

start_service() {
	# Keep the kernel's text console off the HDMI screen: without this, whenever the
	# player isn't showing video (boot, HDMI turned off) the TV shows console text.
	for v in /sys/class/vtconsole/vtcon*; do
		grep -q "frame buffer" "$v/name" 2>/dev/null && echo 0 > "$v/bind"
	done
	[ "$(uci -q get pyxis.hdmi.enabled)" = "0" ] && return 0
	[ -x "$PROG" ] || return 0
	[ -e /dev/dri/card0 ] && [ -e /dev/mpp_service ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" -s 60
	[ "$(uci -q get pyxis.hdmi.match_rate)" = "0" ] && procd_append_param command -r
	[ "$(uci -q get pyxis.hdmi.low_latency)" = "1" ] && procd_append_param command -L
	# Restart on crash forever, 2 s apart.
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "pyxis"
}

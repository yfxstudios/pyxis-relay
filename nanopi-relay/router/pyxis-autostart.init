#!/bin/sh /etc/rc.common
# procd service: starts the PYXIS's stream when the camera comes online (see
# /usr/bin/pyxis-autostart). Installed as /etc/init.d/pyxis-autostart by setup.sh.
# Settings (also on the settings page):
#   uci set pyxis.autostart.enabled=0|1   (default 0)
#   uci set pyxis.autostart.host=ADDRESS  (default empty: the camera's fixed address, else found)
#   uci set pyxis.autostart.stream_lut=0|1 (default 1: display LUT on for the stream when starting it)
# shellcheck disable=SC2034  # START/STOP/USE_PROCD are read by /etc/rc.common

START=97
STOP=08
USE_PROCD=1

PROG=/usr/bin/pyxis-autostart

start_service() {
	rm -f /tmp/pyxis-autostart.json
	[ "$(uci -q get pyxis.autostart.enabled)" = "1" ] || return 0
	[ -x "$PROG" ] || return 0
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "pyxis"
}

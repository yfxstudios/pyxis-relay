# The product's name, in one place. The factory image and the per-unit labels use these;
# change them here when the product name is settled, then rebuild.
BRAND_NAME="PYXIS Relay"          # on labels
SSID_PREFIX="PYXIS-Stream"        # each unit's Wi-Fi is "<prefix>-<unit code>"
RELAY_HOSTNAME="pyxis-relay"      # <hostname>.local on its network
APP_SCHEME="pyxisviewer"          # the viewer apps' join link: <scheme>://join?ssid=…
APP_NAME="PYXIS Viewer"           # on labels

# Copy to config.env and fill in. Read by deploy.sh (on the Mac) and setup.sh (on the NanoPi).
# Values must not contain double quotes, backslashes, $ or backticks.

# Address and name of the NanoPi on its own network (LAN port + Wi-Fi), a /24 network.
ROUTER_IP="192.168.50.1"
ROUTER_HOSTNAME="pyxis-relay"

# DHCP pool for viewers: ROUTER_IP prefix .DHCP_START .. .DHCP_START+DHCP_LIMIT-1
DHCP_START="100"
DHCP_LIMIT="100"

# The camera always gets this address (static DHCP lease). Must be outside the pool.
# CAMERA_MAC is optional; find it in Blackmagic Camera Setup or in the NanoPi's
# DHCP lease list after the camera first connects. Leave empty to skip the lease.
CAMERA_IP="192.168.50.10"
CAMERA_MAC=""

# Wi-Fi access point for viewers. The key must be 8-63 characters.
WIFI_SSID="CHANGE-ME"
WIFI_KEY="CHANGE-ME"
# Two-letter country code: sets legal channels and power.
WIFI_COUNTRY="US"
# 5g (recommended: faster, less crowded) or 2g (longer range, fewer viewers).
WIFI_BAND="5g"
# "default" = 36 on 5g, 6 on 2g. Both start broadcasting right away.
# "auto" lets the router pick, but on 5g it may pick a radar-protected (DFS) channel
# (52-144), which must listen for radar for 60 s before broadcasting and must move or
# go quiet if radar is detected later.
# Or a number (5g non-DFS: 36, 40, 44, 48, 149, 153, 157, 161; 2g: 1, 6, 11).
WIFI_CHANNEL="default"
# auto = WPA2/WPA3 mixed when the router supports it, else WPA2.
# Or force: sae-mixed (WPA2/WPA3), psk2 (WPA2), sae (WPA3 only).
WIFI_ENCRYPTION="auto"
